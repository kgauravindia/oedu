# Protect sensitive files
<FilesMatch "\.(sql|env|git|bak|log|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enable Gzip / Deflate Compression for Crawlers & Browsers
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Browser Caching for Assets & Favicons
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # If the requested file or directory exists physically, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL for University: /university/university-name
    RewriteRule ^university/([^/]+)/?$ university-detail.php?slug=$1 [L,QSA]

    # Clean URL for College: /college/college-name
    RewriteRule ^college/([^/]+)/?$ college-detail.php?slug=$1 [L,QSA]

    # Clean URL for Institute: /institute/institute-name
    RewriteRule ^institute/([^/]+)/?$ institute-detail.php?slug=$1 [L,QSA]

    # Clean URL for School: /school/cbse-school-name
    RewriteRule ^school/([^/]+)/?$ school/school-detail.php?slug=$1 [L,QSA]
    RewriteRule ^school\.php$ school/ [L,R=301]

    # Clean URL for Law College: /law-college/law-college-name
    RewriteRule ^law-college/([^/]+)/?$ law-college-detail.php?slug=$1 [L,QSA]

    # Clean URL for Syllabus: /syllabus
    RewriteRule ^syllabus/?$ syllabus.php [L,QSA]

    # Clean URL for Contact: /contact
    RewriteRule ^contact/?$ contact.php [L,QSA]

    # Clean URL for other top-level pages without .php
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    # XML Sitemap routes
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^sitemap-([a-z0-9\-]+)\.xml$ sitemap.php?section=$1 [L,QSA]
</IfModule>
