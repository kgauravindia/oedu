# 1. Database Dumps & SQLite Files (SENSITIVE)
*.sql
*.sqlite
schema.sql
public/schema.sql

# 2. Database Credentials & Sensitive Configs
includes/db.php
public/includes/db.php
auth.json
sms_log.txt
*.log

# 3. Environment Variables
.env
.env.backup
.env.production
.env.*

# 4. Large Datasets & Spreadsheets
*.xlsx
*.xls
*.csv

# 5. Agent & IDE Directories
.agents/
.codex/
.cursor/
.idea/
.nova/
.vscode/
.zed/
.phpactor.json
.phpunit.cache
.phpunit.result.cache

# 6. Dependencies & Build Artifacts
/node_modules
/vendor
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
Homestead.json
Homestead.yaml
_ide_helper.php

# 7. OS Metadata
.DS_Store
Thumbs.db
